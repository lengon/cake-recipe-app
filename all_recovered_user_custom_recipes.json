    "isCustom": true,
    "name": "檸香瑪斯卡波乳酪蛋糕",
    "englishName": "Mascarpone Cheese Cake with Pastry Crust",
    "description": "結合了酥脆的手作塔皮底與香濃滑順的檸檬瑪斯卡波乳酪內餡，口感輕盈不膩，冷藏隔夜後享用風味更佳。",
    "basePan": {
      "shape": "round",
      "size": 9,
      "unit": "inch"
    },
    "tips": [
      "塔皮可以用手直接操作，只要將所有食材快速拌捏至不黏手即可，避免過度揉捏以免出筋。",
      "刨檸檬皮屑時，小心不要刨到白色苦澀的部份。",
      "這款蛋糕沒有做鏡面淋醬，以簡約的糖粉裝飾即可展現質樸的美感。"
    ],
    "ingredients": [
      {
        "category": "dry",
        "name": "低筋麵粉",
        "baseValue": 200,
        "unit": "g"
      },
      {
        "category": "wet",
        "name": "無鹽奶油",
        "baseValue": 80,
        "unit": "g",
        "note": "可最多到100"
      },
      {
        "category": "wet",
        "name": "牛奶",
        "baseValue": 60,
        "unit": "ml"
      },
      {
        "category": "wet",
        "name": "瑪斯卡波乳酪",
        "baseValue": 500,
        "unit": "g"
      },
      {
        "category": "wet",
        "name": "蛋黃",
        "baseValue": 3,
        "unit": "個"
      },
      {
        "category": "flavor",
        "name": "檸檬汁",
        "baseValue": 1,
        "unit": "個"
      },
      {
        "category": "flavor",
        "name": "檸檬皮屑",
        "baseValue": 1,
        "unit": "個"
      },
      {
        "category": "dry",
        "name": "細砂糖",
        "baseValue": 100,
        "unit": "g"
      },
      {
        "category": "wet",
        "name": "蛋白",
        "baseValue": 3,
        "unit": "個"
      },
      {
        "category": "decor",
        "name": "糖粉",
        "baseValue": 0,
        "unit": "適量",
        "isStatic": true
      }
    ],
    "instructions": [
      {
        "step": 1,
        "text": "將 {低筋麵粉}、切小塊的 {無鹽奶油} 及 {牛奶} 放入攪拌機打成碎屑（或用手操作拌至不黏手），再以手捏合成團。"
      },
      {
        "step": 2,
        "text": "將麵團置於灑了少許麵粉的工作台上，捍成 1-2cm 的厚度，放入抹油或鋪了烤紙的烤模底部，並用叉子在塔底略微戳洞。"
      },
      {
        "step": 3,
        "text": "（可選步驟）如喜歡香脆口感的塔皮，可先將鋪好塔皮的烤模放入預熱至 180°C 的烤箱中，烘烤 10-15 分鐘。"
      },
      {
        "step": 4,
        "text": "製作檸香乳酪蛋黃糊：將 {瑪斯卡波乳酪}、{蛋黃}、{檸檬汁}、{檸檬皮屑} 及 {細砂糖} 放入電動攪拌機中，拌打約 2 分鐘，至呈現均勻的乳霜狀。"
      },
      {
        "step": 5,
        "text": "製作蛋白霜：將 {蛋白} 用手動或電動打蛋器打發至濕性發泡狀態。"
      },
      {
        "step": 6,
        "text": "將打好的乳酪蛋黃糊與打發的 {蛋白} 霜混合，用蛋糕橡皮刮刀輕柔翻拌均勻。"
      },
      {
        "step": 7,
        "text": "將拌勻的蛋糕內餡倒入已鋪好塔皮與烤紙的烤模中。"
      },
      {
        "step": 8,
        "text": "放入預熱至 170°C 的烤箱中，烘烤 35-45 分鐘，取出後放涼即可食用。"
      },
      {
        "step": 9,
        "text": "放入冰箱冷藏至隔日口感會更佳。食用前可在表面均勻灑上 {糖粉} 作為裝飾。"
      }
    ]
  }
}